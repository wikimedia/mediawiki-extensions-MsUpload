{
	"name": "samwilson/msupload",
	"description": "MediaWiki extension for uploading multiple files while using the source editor.",
	"license": "GPL-2.0-or-later",
	"homepage": "https://www.mediawiki.org/wiki/Special:MyLanguage/Extension:MsUpload",
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "52.0.0",
		"mediawiki/minus-x": "2.0.1",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0"
	},
	"scripts": {
		"fix": [
			"minus-x fix .",
			"phpcbf"
		],
		"test": [
			"composer validate",
			"parallel-lint . --exclude vendor --exclude node_modules",
			"@phpcs",
			"minus-x check ."
		],
		"phpcs": "phpcs -sp --cache",
		"foreign-resources": "../../maintenance/run manageForeignResources --extension MsUpload"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"audit": {
			"block-insecure": false
		}
	}
}
